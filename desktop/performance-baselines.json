      "maximum-bounded-transcript-append-render": { "baselineMs": 1800, "ceilingMs": 7500 },
      "repeated-tab-and-session-changes": { "baselineMs": 600, "ceilingMs": 2500 },
      "reconnect-storms": { "baselineMs": 800, "ceilingMs": 3000 },
