{
  "schemaVersion": 1,
  "harnessVersion": 1,
  "description": "Native desktop release performance budgets. Normal checks write observed evidence to dist/performance-report.json and never rewrite this baseline.",
  "clock": "performance.now",
  "samplePolicy": {
    "defaultWarmups": 1,
    "defaultSamples": 5,
    "cold-shell-readiness": { "warmups": 0, "samples": 2 },
