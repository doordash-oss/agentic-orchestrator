{
  "name": "agentic-orchestrator-root",
  "private": true,
  "type": "module",
  "description": "npm workspace root for the Agentico desktop app (Go code is built via Make, not npm).",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "desktop"
  ],
  "scripts": {
    "check": "npm run check --workspace desktop",
    "install:electron-runtime": "npm run install:electron-runtime --workspace desktop",
    "test": "npm run test --workspace desktop",
    "test:security": "npm run test:security --workspace desktop",
    "test:e2e:packaged": "npm run test:e2e:packaged --workspace desktop",
    "e2e:cleanup-handlers": "npm run e2e:cleanup-handlers --workspace desktop --",
    "build": "npm run build --workspace desktop",
    "package:build": "npm run package:build --workspace desktop",
    "package:verify": "npm run package:verify --workspace desktop",
    "package:verify:e2e": "npm run package:verify:e2e --workspace desktop",
    "generate:api": "npm run generate:api --workspace desktop",
    "audit:release": "npm run audit:release --workspace desktop",
    "test:performance": "npm run test:performance --workspace desktop",
    "release:credentials:check": "npm run release:credentials:check --workspace desktop",
    "release:verify": "npm run release:verify --workspace desktop"
  }
}
