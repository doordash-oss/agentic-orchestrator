# Development-build update bridge contract.
#
# The testscript binary is compiled by `go test`, so it is inherently a
# development build: build info reports "(devel)", no release version is
# injected, and it does not live in the Go bin dir.

# Bare `agentico update` on a dev build remains a discovery-compatible,
# non-mutating command. If no desktop app is registered, it prints source
# guidance without checking the network or touching the binary.
env AGENTICO_UPDATE_DISABLE_DESKTOP_BRIDGE=1
exec agentico update
stdout 'Install method:'
stdout 'development build'
stdout 'Pull the source checkout and rebuild'
! stderr .

# The dev-build bare path must never print the network "Checking for updates"
# line — classification happens before any GitHub call.
exec agentico update
! stdout 'Checking for updates'
